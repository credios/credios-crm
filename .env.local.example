# ============================================
# CREDIOS CRM — Template de variáveis de ambiente
# ============================================
# Copiar para .env.local e preencher com valores reais.
# Valores reais de dev/prod ficam em local seguro fora do repositório.
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres direta (Drizzle e migrations).
# IMPORTANTE: caracteres especiais na senha (+ * / # @ etc.) precisam estar URL-encoded.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.your-project.supabase.co:5432/postgres

# --- Google OAuth (configurado no Supabase Auth, aqui apenas para referência) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Webhook (autentica POST /api/webhooks/lead e /api/webhooks/parceiro) ---
# Gerar com: openssl rand -base64 32. É o MESMO segredo que o portal e o site
# enviam em x-webhook-secret (no portal: CRM_WEBHOOK_SECRET).
WEBHOOK_SECRET=

# --- Portal de Parceiros (chamadas CRM → portal: handoff + status de lead) ---
# URL base do portal e segredo enviado em x-portal-secret. No portal, o segredo
# correspondente é PORTAL_WEBHOOK_SECRET.
PORTAL_WEBHOOK_URL=https://parceiros.credios.com.br
PORTAL_WEBHOOK_SECRET=

# --- Resend (email transacional) ---
RESEND_API_KEY=
EMAIL_FROM=crm@credios.com.br
EMAIL_REPLY_TO=gabriel@credios.com.br

# --- Cron (Vercel) ---
# Vercel injeta no Authorization quando dispara o cron. Defina no dashboard do
# Vercel (Settings → Environment Variables) com `openssl rand -base64 32`.
# Em dev pode deixar qualquer string; endpoint aceita sem auth fora de prod.
CRON_SECRET=

# --- Google Ads (offline conversion import) ---
# SEGREDOS — preencher manualmente, NUNCA commitar:
GADS_DEVELOPER_TOKEN=        # API Center da MCC
GADS_CLIENT_SECRET=          # Cloud Console → OAuth client (regerar se vazou)
GADS_REFRESH_TOKEN=          # sai de: npx tsx scripts/gerar-refresh-token.ts
# IDENTIFICADORES (não-secretos):
GADS_CLIENT_ID=945343422985-mkrffv34lk8bpvu3sscqcqvfhjppifbg.apps.googleusercontent.com
GADS_CUSTOMER_ID=7089773939
GADS_LOGIN_CUSTOMER_ID=6693819042
GADS_ACTION_QUALIFIED=customers/7089773939/conversionActions/7663352106
GADS_ACTION_CLOSED=customers/7089773939/conversionActions/7663362433
# Dry-run: "true" valida o payload sem gravar conversões (Parte 12 do plano).
GADS_VALIDATE_ONLY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Direct Data (score de crédito por CPF — QUOD)
DIRECTD_TOKEN=
